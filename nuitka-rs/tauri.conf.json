{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuitka++",
  "version": "0.1.0",
  "identifier": "com.nuitkaplus.desktop",
  "build": {
    "frontendDist": "src/ui/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nuitka++",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}

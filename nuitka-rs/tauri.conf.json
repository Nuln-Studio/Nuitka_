{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nuitka++",
  "version": "0.1.0",
  "identifier": "com.nuitkaplus.desktop",
  "build": {
    "frontendDist": "src/ui/web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nuitka++",
        "width": 520,
        "height": 460,
        "resizable": false,
        "center": true,
        "decorations": false,
        "theme": "Dark",
        "backgroundColor": "#070A10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
